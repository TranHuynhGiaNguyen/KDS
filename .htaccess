# SmartDine - Bảo mật Apache khi deploy lên domain chính thức
Options -Indexes

# Chặn truy cập trực tiếp các file cấu hình nhạy cảm, SQL dump, tài liệu & log
<FilesMatch "(?i)\.(sql|docx|log|md|ini|example|sh|bat)$|local\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)^\.(git|htaccess|user\.ini|gitignore)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Chặn truy cập trực tiếp qua HTTP vào thư mục cấu hình, kiểm thử & Git
<IfModule mod_alias.c>
  RedirectMatch 403 (?i)(?:^|/)(?:\.git|tests|config)(?:/|$)
</IfModule>
